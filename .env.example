# ───────────── Frontend (Vite) — valores PÚBLICOS, vão para o navegador ─────────────
# Projeto Supabase (Settings → API). Sem estes valores o app funciona apenas na demonstração.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Opcional: Maps JavaScript API para o mapa com ruas. Restrinja por domínio (HTTP referrer)
# e somente à "Maps JavaScript API" no Google Cloud. Sem ela, o app usa o mapa ilustrativo.
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Opcional: URL base das funções (padrão: <VITE_SUPABASE_URL>/functions/v1)
VITE_SUPABASE_FUNCTIONS_URL=

# ───────────── Servidor (Supabase Edge Function rota-api) — SEGREDOS ─────────────
# Configure com: supabase secrets set NOME=valor   (nunca coloque no frontend)
# ANTHROPIC_API_KEY=            # leitura das notinhas (Claude, visão + saída estruturada)
# ANTHROPIC_MODEL=claude-opus-5-5
# OCR_EFFORT=medium
# GOOGLE_MAPS_SERVER_KEY=       # Geocoding API + Routes API (restrinja por API; sem referrer)
# MAX_ORDERS_PER_ROUTE=15
# DAILY_OCR_IMAGES_PER_USER=300
# IMAGE_RETENTION_DAYS=7
# CRON_SECRET=                  # protege a ação "retention" chamada por agendamento
# ALLOWED_ORIGINS=https://seu-dominio.com.br
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY já existem nas Edge Functions.
